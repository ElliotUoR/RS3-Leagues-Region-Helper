# Copy to .env on the server (same directory as docker-compose.yml) and
# fill in real values. Never commit the real .env file.

# Must match the password baked into migrations/001_init.sql's
# `create role authenticator login password '...'` line - Postgres doesn't
# read this variable itself, it's just passed to PostgREST so the two agree.
POSTGRES_AUTHENTICATOR_PASSWORD=CHANGE_ME_AUTHENTICATOR_PASSWORD

# Superuser password for the postgres role itself (admin/db-client access
# only - never used by PostgREST).
POSTGRES_SUPERUSER_PASSWORD=changeme

# GitHub token with `issues:write` on GITHUB_REPO - a fine-grained PAT
# scoped to just this one repo is preferable to a classic PAT with broad
# `repo` scope. Used only server-side by the Node service.
GITHUB_TOKEN=changeme
GITHUB_REPO=elliotuor/RS3-Leagues-Region-Helper

# Static secret used to derive the daily-rotating analytics session salt -
# generate with `openssl rand -hex 32`. Never reused elsewhere.
ANALYTICS_SALT_SECRET=changeme

# Origin (scheme + host, no path/trailing slash) of the static GitHub Pages
# mirror - allowed via CORS on POST /api/shorten only, so a visitor there
# can carry their saved loadout over as a short link when they follow a
# "visit the live site" link (see src/hooks/useLiveSiteUrl.js). Nothing
# else on this server accepts cross-origin requests.
PAGES_ORIGIN=https://elliotuor.github.io

# Password for the low-privilege `analytics` Postgres role, created by
# deploy/migrations/002_analytics_rollup.sql - must match the value you put
# in that migration file before it's applied. Used by the Node service's
# daily analytics rollup job and the admin stats API (never by PostgREST).
ANALYTICS_DB_PASSWORD=changeme

# bcrypt hash of the single JellyFlow admin dashboard password (there's no
# username/account system - just one shared password). Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# (run from server/, after `npm install`). Never store the plaintext
# password anywhere, including here.
ADMIN_PASSWORD_HASH=changeme

# Signs the admin dashboard's session cookie - generate with
# `openssl rand -hex 32`. Never reused elsewhere.
ADMIN_SESSION_SECRET=changeme
