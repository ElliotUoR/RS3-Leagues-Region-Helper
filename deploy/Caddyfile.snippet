# Routing fragment for jellyflow.xyz/Leagues - NOT a standalone site block.
# jellyflow.xyz hosts multiple independent projects (this one lives under
# /Leagues; a separate JellyFlow landing-page repo owns "/" and anything
# else), so no single project can own the whole `jellyflow.xyz { }` block.
#
# Deploy this file to /opt/caddy-shared/conf.d/leagues.caddy on the server
# (one-time shared setup below) and reload Caddy - do NOT wrap it in its own
# "jellyflow.xyz { }" block, and do not append it directly into the
# livekit.yourdomain.com Caddyfile the way earlier versions of this file
# said to.

redir /Leagues /Leagues/

handle_path /Leagues/* {
	# The two write endpoints -> Node service. Paths here have already had
	# the /Leagues prefix stripped, so they match exactly what the Node
	# service's own routes expect (/api/shorten, /api/report-issue, etc).
	# NOTE: /s/:code short links deliberately do NOT go here anymore - see
	# below, they're served by the static frontend instead.
	@backend path /api/*
	reverse_proxy @backend rs3_node:3000

	# Public PostgREST API (anon insert-only + the short-link RPC) -
	# stripped of the /rest prefix too, so e.g. /Leagues/rest/page_events
	# maps to PostgREST's own /page_events route. The frontend calls
	# /rest/rpc/get_short_link_payload directly from here to resolve a
	# short code client-side (utils/api.js resolveShortCode) - the address
	# bar keeps showing the short link the whole time instead of ever
	# expanding into a long `?share=` URL.
	handle_path /rest/* {
		reverse_proxy rs3_postgrest:3000
	}

	# Everything else under /Leagues/* -> the static build, including
	# /s/:code short links - the frontend's nginx has a SPA fallback
	# (deploy/nginx.conf) that serves index.html for any unknown path, and
	# the app itself resolves the code from there (see App.jsx).
	reverse_proxy rs3_frontend:80
}
