# Routing fragment for jellyflow.xyz/Leagues - NOT a standalone site block.
# jellyflow.xyz hosts multiple independent projects (this one lives under
# /Leagues; a separate JellyFlow landing-page repo owns "/" and anything
# else), so no single project can own the whole `jellyflow.xyz { }` block.
#
# Deploy this file to /opt/caddy-shared/conf.d/leagues.caddy on the server
# (one-time shared setup below) and reload Caddy - do NOT wrap it in its own
# "jellyflow.xyz { }" block, and do not append it directly into the
# livekit.yourdomain.com Caddyfile the way earlier versions of this file
# said to.

redir /Leagues /Leagues/

handle_path /Leagues/* {
	# Short link redirects and the two write endpoints -> Node service.
	# Paths here have already had the /Leagues prefix stripped, so they
	# match exactly what the Node service's own routes expect (/s/:code,
	# /api/shorten, etc).
	@backend path /s/* /api/*
	reverse_proxy @backend rs3_node:3000

	# Public PostgREST API (anon insert-only + the short-link RPC) -
	# stripped of the /rest prefix too, so e.g. /Leagues/rest/page_events
	# maps to PostgREST's own /page_events route.
	handle_path /rest/* {
		reverse_proxy rs3_postgrest:3000
	}

	# Everything else under /Leagues/* -> the static build (hash-routed
	# SPA, so no extra rewrite rules needed - there's only ever one real
	# path per the app itself, "/Leagues/").
	reverse_proxy rs3_frontend:80
}
