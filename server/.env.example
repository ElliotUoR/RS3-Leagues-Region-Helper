# Copy to .env for local dev (node --env-file=.env src/index.js).
# In production these are set via deploy/docker-compose.yml's environment:
# block, sourced from deploy/.env - never commit real values.

PORT=3000

# Internal URL of the PostgREST container - service name from docker-compose,
# not a public hostname.
POSTGREST_URL=http://localhost:54321

# GitHub token with `issues:write` on GITHUB_REPO, used to file anonymous
# reports. A fine-grained PAT scoped to just this one repo is preferable to
# a classic PAT with broad `repo` scope.
GITHUB_TOKEN=changeme
GITHUB_REPO=elliotuor/RS3-Leagues-Region-Helper

# Used to build the redirect target for resolved short links -
# e.g. https://rs3.yourdomain.example
PUBLIC_SITE_URL=http://localhost:5173

# Static secret used to derive the daily-rotating analytics salt (see
# lib/session.js) - generate with `openssl rand -hex 32`. Never reused for
# anything else, never sent to the browser.
ANALYTICS_SALT_SECRET=changeme
