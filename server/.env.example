# Copy to .env for local dev (node --env-file=.env src/index.js).
# In production these are set via deploy/docker-compose.yml's environment:
# block, sourced from deploy/.env - never commit real values.

PORT=3000

# Internal URL of the PostgREST container - service name from docker-compose,
# not a public hostname.
POSTGREST_URL=http://localhost:54321

# GitHub token with `issues:write` on GITHUB_REPO, used to file anonymous
# reports. A fine-grained PAT scoped to just this one repo is preferable to
# a classic PAT with broad `repo` scope.
GITHUB_TOKEN=changeme
GITHUB_REPO=elliotuor/RS3-Leagues-Region-Helper

# Static secret used to derive the daily-rotating analytics salt (see
# lib/session.js) - generate with `openssl rand -hex 32`. Never reused for
# anything else, never sent to the browser.
ANALYTICS_SALT_SECRET=changeme

# Origin (scheme + host, no path) of the static GitHub Pages mirror -
# allowed via CORS on POST /api/shorten only (see routes/shorten.js).
PAGES_ORIGIN=https://elliotuor.github.io

# Connection string for the low-privilege `analytics` Postgres role (see
# deploy/migrations/002_analytics_rollup.sql) - used by the daily rollup
# job (lib/analyticsRollup.js) and the admin stats API (routes/admin.js).
ANALYTICS_DATABASE_URL=postgres://analytics:changeme@localhost:54322/rs3

# bcrypt hash of the single JellyFlow admin password - generate with
# `node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"`.
# Never store the plaintext password anywhere.
ADMIN_PASSWORD_HASH=changeme

# Signs the admin session cookie (see lib/adminAuth.js) - generate with
# `openssl rand -hex 32`. Never reused elsewhere.
ADMIN_SESSION_SECRET=changeme

# Superuser connection string, used only by `npm run migrate`
# (scripts/migrate.js) to apply deploy/migrations/*.sql - never given to
# the long-running server itself.
DATABASE_URL=postgres://postgres:changeme@localhost:54322/rs3
