# Local development env for the Node service. Copy to server/.env:
#
#   cp server/.env.dev.example server/.env
#
# server/.env is gitignored. These values pair with deploy/docker-compose.dev.yml
# and are deliberately worthless - that database is bound to 127.0.0.1 and holds
# nothing but test data. Never reuse any of them anywhere real.
#
# `npm run dev` in server/ loads this file automatically (node --env-file=.env).

PORT=3000

# PostgREST, published by the dev compose file on 3001.
POSTGREST_URL=http://127.0.0.1:3001

# The low-privilege role the admin dashboard and the analytics rollup use.
ANALYTICS_DATABASE_URL=postgres://analytics:devpassword@127.0.0.1:5432/rs3

# Superuser - only read by scripts/migrate.js, never by the running server.
# `npm run dev:db:migrate` sets this itself, so it is here only for the case
# where you want to run migrate.js by hand.
DATABASE_URL=postgres://postgres:devpassword@127.0.0.1:5432/rs3

# Salt for the pseudonymous analytics/vote session id (lib/session.js). Any
# non-empty string works locally; changing it invalidates existing votes,
# which is occasionally a useful way to test voting again as a "new" visitor.
ANALYTICS_SALT_SECRET=dev-salt-not-secret

# Admin login. The hash below is bcrypt of the literal password "admin".
# Generate another with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" mypassword
ADMIN_PASSWORD_HASH=$2a$10$uQW0cECBXa.v5HcKHA60u.jAbLcxtPReFXVS8wHrK9zBobOn4zYzG
ADMIN_SESSION_SECRET=dev-admin-secret-not-secret

# GitHub issue filing (Report a build, Report issue, the auto-report on a
# failed publish). LEAVE THESE UNSET unless you specifically want to test
# filing: with no token those routes fail cleanly, which is itself the more
# useful thing to test. Setting them files REAL issues on a REAL repo.
# GITHUB_TOKEN=
# GITHUB_REPO=yourname/your-test-repo
